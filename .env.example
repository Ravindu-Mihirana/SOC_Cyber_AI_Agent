# Optional local AI endpoint settings. Copy this file to .env and edit values.
SOC_AI_BASE_URL=http://127.0.0.1:11434
SOC_AI_MODEL=llama3.1:8b
SOC_AI_API_KEY=

# Optional defaults for the Burp Suite instance hosting its REST API.
# Enable Settings -> Suite -> REST API in Burp and keep it on loopback when
# Burp and this dashboard run on the same Kali VM.
BURP_API_URL=http://127.0.0.1:1337
BURP_API_KEY=

# Optional: store assessments and raw reports outside the project directory.
# SOC_AGENT_DATA_DIR=/home/your-user/soc-cyber-data

# Optional when Nikto is checked out from source instead of installed on PATH.
# NIKTO_SCRIPT=/path/to/nikto/program/nikto.pl
